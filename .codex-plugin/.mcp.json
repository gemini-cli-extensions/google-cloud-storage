{
  "mcpServers": {
    "cloud-storage": {
      "command": "npx",
      "args": [
        "-y",
        "@toolbox-sdk/server@1.9.0",
        "--prebuilt",
        "cloud-storage",
        "--stdio",
        "--user-agent-metadata",
        "gcs-skills/1.0 (skill:gcs-skills-mcp-traffic)"
      ],
      "env_vars": [
        "CLOUD_STORAGE_PROJECT"
      ]
    }
  }
}
