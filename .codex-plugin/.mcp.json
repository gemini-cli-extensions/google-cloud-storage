{
  "mcpServers": {
    "cloud-storage": {
      "command": "npx",
      "args": [
        "-y",
        "@toolbox-sdk/server@1.13.1",
        "--prebuilt",
        "cloud-storage",
        "--stdio",
        "--user-agent-metadata",
        "gcs-skills/1.0 (skill:gcs-skills-mcp-traffic)"
      ],
      "env_vars": [
        "CLOUD_STORAGE_PROJECT"
      ]
    },
    "google-cloud-storage-okf": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "${PLUGIN_ROOT}/skills/google-cloud-storage-okf/scripts/mcp_server.py"
      ],
      "env_vars": [
        "CLOUD_STORAGE_PROJECT"
      ]
    }
  }
}
